# Groq API. Create a key at https://console.groq.com/keys.
# Keep this key server-side; never expose it in client code.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Local per-model pacing; lower this to match a stricter Groq RPM limit.
GROQ_MAX_REQUESTS_PER_MINUTE=8

# OpenRouter is used only for camera map layout planning (buildings, obstacles, and
# camera suggestions with reasoning); all other AI tasks use Groq.
# Create a key at https://openrouter.ai/keys and keep it server-side.
OPENROUTER_API_KEY=
OPENROUTER_LAYOUT_MODEL=openrouter/free
# Free-model fallbacks tried automatically when the primary model returns unusable JSON.
OPENROUTER_LAYOUT_FALLBACK_MODEL_1=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_LAYOUT_FALLBACK_MODEL_2=google/gemma-4-31b-it:free
# Conservative local-process limits below OpenRouter's documented free-plan daily cap.
OPENROUTER_LAYOUT_MAX_REQUESTS_PER_DAY=40
OPENROUTER_LAYOUT_MAX_REQUESTS_PER_MINUTE=3

# Clerk authentication (create/configure your instance in the Clerk dashboard).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Set this to the deployed document service URL in Vercel.
DOC_SERVICE_URL=http://localhost:8001
